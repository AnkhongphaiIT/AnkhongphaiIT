# Sao chép file này thành ".env" ở thư mục gốc gói server (KHÔNG commit, KHÔNG gửi cho ai) rồi điền giá trị.
# Tạo khóa dịch vụ ngẫu nhiên:  python3 -c "import secrets;print(secrets.token_urlsafe(32))"
CABAY_ENV=production
CABAY_SERVICE_KEY=<dán-khóa-ngẫu-nhiên-ở-đây>
# Origin được phép gọi API từ trình duyệt: trang itch.io nhúng game từ các origin dưới (kiểm lại origin thật khi thử)
CABAY_ALLOWED_ORIGINS=https://html-classic.itch.zone,https://html.itch.zone
# 1 khi đứng sau đường hầm/reverse proxy (để giới hạn thử sai theo IP thật)
CABAY_TRUST_PROXY=1
# Số phòng chạy đồng thời (mỗi phòng tối đa 4 người). Tăng sau khi đã đo tải máy.
CABAY_MAX_ROOMS=4
CABAY_API_PORT=8787
CABAY_WS_PORT=8910
CABAY_WS_BIND=127.0.0.1
# 1 = một cổng (P-035): backend phục vụ luôn trang game (thư mục web/) và chuyển tiếp /ws tới room server trên máy này;
# một đường hầm vào cổng CABAY_API_PORT là ra một link chơi được. run/choi_thu.* tự bật. Để 0 nếu dùng bản web trên itch.io.
CABAY_SELFHOST=0
# Chỉ Windows: đường dẫn Godot 4.7.2 bản console chính thức
# GODOT_EXE=C:\Tools\Godot\Godot_v4.7.2-stable_win64_console.exe
