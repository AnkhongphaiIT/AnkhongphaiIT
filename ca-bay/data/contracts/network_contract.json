{
  "schema_version": "1.0.0",
  "protocol_version": "1.0.0",
  "status": "design_specification_not_implemented",
  "authority": "dedicated_godot_server_with_transactional_persistence",
  "transport": {
    "class": "WebSocketMultiplayerPeer",
    "public_scheme": "wss",
    "local_scheme": "ws",
    "rpc_transfer_mode": "reliable",
    "browser_is_client_only": true,
    "authentication": "single_use_ticket_in_SceneMultiplayer_auth_message",
    "secrets_in_url": false
  },
  "limits": {
    "players_per_room": 4,
    "initial_concurrent_rooms": 1,
    "simulation_hz": 30,
    "input_hz": 20,
    "snapshot_hz": 10,
    "interpolation_ms": 100,
    "max_client_payload_bytes": 8192,
    "max_server_payload_bytes": 65536,
    "max_pending_messages_per_peer": 64,
    "max_unacked_snapshot_sets": 2,
    "max_snapshot_reassembly_bytes": 2097152,
    "snapshot_chunk_expiry_s": 3,
    "websocket_auth_timeout_s": 5,
    "ticket_ttl_s": 30,
    "heartbeat_interval_s": 5,
    "heartbeat_timeout_s": 15,
    "reconnect_grace_s": 90,
    "afk_timeout_s": 120,
    "checkpoint_interval_s": 15,
    "access_token_ttl_s": 900,
    "refresh_session_max_s": 43200,
    "idempotency_retention_days": 7
  },
  "envelope": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "protocol_version",
      "type",
      "request_id",
      "connection_id",
      "room_id",
      "seq",
      "payload"
    ],
    "properties": {
      "protocol_version": {
        "const": "1.0.0"
      },
      "type": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "request_id": {
        "type": "string",
        "format": "uuid"
      },
      "connection_id": {
        "type": "string",
        "format": "uuid"
      },
      "room_id": {
        "type": "string",
        "format": "uuid"
      },
      "seq": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "payload": {
        "type": "object"
      }
    }
  },
  "authentication_payload": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ticket",
      "protocol_version",
      "content_hash"
    ],
    "properties": {
      "ticket": {
        "type": "string",
        "minLength": 32,
        "maxLength": 256
      },
      "protocol_version": {
        "const": "1.0.0"
      },
      "content_hash": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    }
  },
  "http_endpoints": [
    {
      "method": "POST",
      "path": "/v1/auth/register",
      "auth": "public_rate_limited",
      "purpose": "Username/password create; recovery codes shown once. No email service assumed."
    },
    {
      "method": "POST",
      "path": "/v1/auth/login",
      "auth": "public_rate_limited",
      "purpose": "Return access/rotating-refresh tokens; do not store plaintext tokens."
    },
    {
      "method": "POST",
      "path": "/v1/auth/refresh",
      "auth": "refresh_token",
      "purpose": "Rotate refresh token and issue short-lived access token."
    },
    {
      "method": "POST",
      "path": "/v1/auth/logout",
      "auth": "access_token",
      "purpose": "Revoke session, tickets and gameplay lease."
    },
    {
      "method": "POST",
      "path": "/v1/auth/recover",
      "auth": "recovery_code_rate_limited",
      "purpose": "Consume recovery code, change password, revoke all sessions, replace recovery codes."
    },
    {
      "method": "GET",
      "path": "/v1/account/save",
      "auth": "access_token",
      "purpose": "Return own validated account_save v2 only; no client PUT/save overwrite."
    },
    {
      "method": "GET",
      "path": "/v1/rooms",
      "auth": "access_token",
      "purpose": "Return public room summaries with seats/status; no other players' private saves."
    },
    {
      "method": "POST",
      "path": "/v1/rooms",
      "auth": "access_token",
      "purpose": "Request create room; Godot lifecycle acknowledgement required before ready."
    },
    {
      "method": "POST",
      "path": "/v1/rooms/{room_id}/join",
      "auth": "access_token",
      "purpose": "Validate invite/unlock/capacity; reserve seat bounded by ticket expiry."
    },
    {
      "method": "POST",
      "path": "/v1/rooms/{room_id}/ticket",
      "auth": "access_token",
      "purpose": "Issue single-use 30-second room/session ticket."
    },
    {
      "method": "POST",
      "path": "/v1/account/takeover",
      "auth": "access_token",
      "purpose": "Explicit UX choice to advance lease epoch and invalidate old gameplay session."
    },
    {
      "method": "GET",
      "path": "/healthz",
      "auth": "public",
      "purpose": "Liveness without secrets, account info or database paths."
    },
    {
      "method": "POST",
      "path": "/internal/tickets/consume",
      "auth": "private_service",
      "purpose": "Atomic consume ticket, allocate gameplay lease, return own save."
    },
    {
      "method": "POST",
      "path": "/internal/accounts/commit",
      "auth": "private_service",
      "purpose": "Validate service identity/lease epoch/version/op id and commit durable mutation."
    },
    {
      "method": "POST",
      "path": "/internal/accounts/checkpoint",
      "auth": "private_service",
      "purpose": "Hunger/safe spawn checkpoint with active lease and expected version."
    },
    {
      "method": "GET",
      "path": "/internal/room-controls",
      "auth": "private_service",
      "purpose": "Godot polls queued create/join/takeover/lifecycle controls."
    },
    {
      "method": "POST",
      "path": "/internal/room-status",
      "auth": "private_service",
      "purpose": "Godot acknowledges controls and reports room/lease heartbeats."
    },
    {
      "method": "DELETE",
      "path": "/v1/account",
      "auth": "access_token",
      "purpose": "Require current password in body and reauthentication within 5 minutes; explicit destructive UX. Atomically revoke all account sessions/tickets/leases and delete own account data only. Existing backups expire under published retention; do not claim instant removal from historical backups."
    },
    {
      "method": "POST",
      "path": "/v1/auth/password",
      "auth": "access_token",
      "purpose": "Require current password and new password validation; change slow hash and revoke all sessions/tickets/leases. User signs in again."
    }
  ],
  "messages": [
    {
      "name": "player.input",
      "direction": "client_to_server",
      "stage": "authenticated",
      "max_per_second": 20,
      "durable": false,
      "description": "Server simulates movement. No client position or velocity accepted.",
      "payload_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "move_x",
          "move_z",
          "look_yaw_rad",
          "look_pitch_rad",
          "jump"
        ],
        "properties": {
          "move_x": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "move_z": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "look_yaw_rad": {
            "type": "number",
            "minimum": -3.141592653589793,
            "maximum": 3.141592653589793
          },
          "look_pitch_rad": {
            "type": "number",
            "minimum": -1.5,
            "maximum": 1.5
          },
          "jump": {
            "type": "boolean"
          }
        }
      }
    },
