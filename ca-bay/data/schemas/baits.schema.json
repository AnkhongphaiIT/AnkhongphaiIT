{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cabay.local/schemas/baits.schema.json",
  "title": "Mồi",
  "description": "data/content/baits.json",
  "type": "object",
  "required": [
    "schema_version",
    "meta",
    "records"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "meta": {
      "$ref": "common.schema.json#/$defs/meta"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name_key",
          "status",
          "tier",
          "infinite",
          "consumed_on",
          "bite_time_s",
          "assets"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/bait_id"
          },
          "name_key": {
            "$ref": "common.schema.json#/$defs/loc_key"
          },
          "status": {
            "$ref": "common.schema.json#/$defs/status"
          },
          "tier": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "infinite": {
            "type": "boolean",
            "description": "true = mồi miễn phí không bao giờ hết"
          },
          "consumed_on": {
            "enum": [
              "hook"
            ],
            "description": "DEC-015: trừ mồi khi cá dính (F11–F13), không trừ khi quăng; số lượng mỗi lần mua do shops.json quyết định"
          },
          "bite_time_s": {
            "$ref": "common.schema.json#/$defs/range_f"
          },
          "summons_boss_id": {
            "$ref": "common.schema.json#/$defs/boss_id"
          },
          "flags": {
            "type": "array",
            "items": {
              "enum": [
                "quest",
                "no_sell",
                "no_steal"
              ]
            }
          },
          "assets": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "icon",
              "lure_model"
            ],
            "properties": {
              "icon": {
                "$ref": "common.schema.json#/$defs/asset_id"
              },
              "lure_model": {
                "$ref": "common.schema.json#/$defs/asset_id"
              }
            }
          }
        }
      }
    }
  }
}
