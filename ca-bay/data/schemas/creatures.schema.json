{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cabay.local/schemas/creatures.schema.json",
  "title": "Sinh vật",
  "description": "data/content/creatures.json",
  "type": "object",
  "required": [
    "schema_version",
    "meta",
    "records"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "meta": {
      "$ref": "common.schema.json#/$defs/meta"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name_key",
          "desc_key",
          "status",
          "island_ids",
          "tier",
          "archetype",
          "length_m",
          "mass_kg",
          "hp",
          "base_value",
          "ko_duration_s",
          "thrash",
          "launch",
          "behavior",
          "variants",
          "is_boss",
          "dex_order",
          "assets"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/creature_id"
          },
          "name_key": {
            "$ref": "common.schema.json#/$defs/loc_key"
          },
          "desc_key": {
            "$ref": "common.schema.json#/$defs/loc_key"
          },
          "status": {
            "$ref": "common.schema.json#/$defs/status"
          },
          "island_ids": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/island_id"
            },
            "minItems": 1
          },
          "tier": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "description": "0 = dễ nhất; 3 = boss"
          },
          "archetype": {
            "enum": [
              "flopper",
              "hopper",
              "runner",
              "pincher",
              "biter",
              "boss"
            ]
          },
          "length_m": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Kích thước gameplay (m); mô hình phải khớp ±10%"
          },
          "mass_kg": {
            "type": "number",
            "minimum": 0.2,
            "description": "Khối lượng vật lý trong game (không phải khối lượng thật)"
          },
          "hp": {
            "type": "integer",
            "minimum": 1
          },
          "base_value": {
            "type": "integer",
            "minimum": 0
          },
          "ko_duration_s": {
            "type": "number",
            "minimum": 0
          },
          "thrash": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rate_per_s",
              "duration_s",
              "strain_gain_per_s"
            ],
            "properties": {
              "rate_per_s": {
                "type": "number",
                "minimum": 0
              },
              "duration_s": {
                "type": "number",
                "minimum": 0
              },
              "strain_gain_per_s": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "launch": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "apex_m",
              "spin_rad_s"
            ],
            "properties": {
              "apex_m": {
                "$ref": "common.schema.json#/$defs/range_f"
              },
              "spin_rad_s": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "behavior": {
            "type": "object",
            "description": "Tham số theo archetype",
            "properties": {
              "flop_interval_s": {
                "$ref": "common.schema.json#/$defs/range_f"
              },
              "flop_impulse": {
                "type": "number"
              },
              "hop_interval_s": {
                "$ref": "common.schema.json#/$defs/range_f"
              },
              "hop_impulse": {
                "type": "number"
              },
              "run_speed_mps": {
                "type": "number"
              },
              "chase_speed_mps": {
                "type": "number"
              },
              "lunge_interval_s": {
                "$ref": "common.schema.json#/$defs/range_f"
              },
              "lunge_impulse": {
                "type": "number"
              }
            },
            "additionalProperties": false
          },
          "attack": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "damage",
              "range_m",
              "cooldown_s",
              "telegraph_s"
            ],
            "properties": {
              "damage": {
                "type": "integer",
                "minimum": 0
              },
              "range_m": {
                "type": "number"
              },
              "cooldown_s": {
                "type": "number"
              },
              "telegraph_s": {
                "type": "number"
              }
            }
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "variant_id",
                "name_key",
                "chance",
                "value_mult",
                "accessory_asset_id",
                "status"
              ],
              "properties": {
                "variant_id": {
                  "$ref": "common.schema.json#/$defs/variant_id"
                },
                "name_key": {
                  "$ref": "common.schema.json#/$defs/loc_key"
                },
                "chance": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "value_mult": {
                  "type": "number",
                  "minimum": 1
                },
                "accessory_asset_id": {
                  "$ref": "common.schema.json#/$defs/asset_id"
                },
                "status": {
                  "$ref": "common.schema.json#/$defs/status"
                }
              }
            }
          },
          "is_boss": {
            "type": "boolean"
          },
          "boss_id": {
            "$ref": "common.schema.json#/$defs/boss_id"
          },
          "dex_order": {
            "type": "integer",
            "minimum": 1
          },
          "assets": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "model",
              "icon"
            ],
            "properties": {
              "model": {
                "$ref": "common.schema.json#/$defs/asset_id"
              },
              "icon": {
                "$ref": "common.schema.json#/$defs/asset_id"
              }
            }
          }
        }
      }
    }
  }
}
