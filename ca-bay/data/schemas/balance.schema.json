          "type": "number"
        },
        "launch_land_before_player_m": {
          "type": "number"
        },
        "launch_land_spread_m": {
          "type": "number"
        },
        "perfect_yank_bonus_apex_m": {
          "type": "number"
        },
        "post_launch_lock_s": {
          "type": "number"
