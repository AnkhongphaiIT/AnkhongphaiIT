        "regen_per_s": {
          "type": "number"
        },
        "respawn_delay_s": {
          "type": "number"
        },
        "height_m": {
          "type": "number"
        },
        "eye_height_m": {
          "type": "number"
        },
        "walk_speed_mps": {
          "type": "number"
        },
        "jump_velocity_mps": {
          "type": "number"
        },
        "item_throw_speed_mps": {
          "type": "number"
        }
      }
