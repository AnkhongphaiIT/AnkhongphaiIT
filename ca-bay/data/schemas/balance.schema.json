      "type": "object",
      "additionalProperties": false,
      "required": [
        "auto_swap_after_launch",
        "reel_mode",
        "music_volume_db",
        "sfx_volume_db",
        "look_sensitivity",
        "invert_y",
        "language",
        "quality",
        "fov_deg"
      ],
      "properties": {
        "auto_swap_after_launch": {
          "type": "boolean"
        },
        "reel_mode": {
          "enum": [
            "hold",
            "toggle"
          ]
        },
        "music_volume_db": {
          "type": "number"
        },
        "sfx_volume_db": {
          "type": "number"
        },
        "look_sensitivity": {
          "type": "number"
        },
        "invert_y": {
          "type": "boolean"
        },
        "language": {
          "enum": [
            "auto",
            "en",
            "vi"
          ]
        },
        "quality": {
          "enum": [
            "auto",
            "low",
            "medium",
            "high"
          ]
        },
        "fov_deg": {
          "type": "number"
        }
      }
    }
