      "type": "object",
      "additionalProperties": false,
      "required": [
        "stuck_timeout_s",
        "knockup_min_mps",
        "ko_blink_before_wake_s"
      ],
      "properties": {
        "stuck_timeout_s": {
          "type": "number"
        },
        "knockup_min_mps": {
          "type": "number"
        },
        "ko_blink_before_wake_s": {
          "type": "number"
        }
