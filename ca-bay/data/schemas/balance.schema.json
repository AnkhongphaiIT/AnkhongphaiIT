      "type": "object",
      "additionalProperties": false,
      "required": [
        "steal_delay_s",
        "cooldown_s",
        "min_item_value",
        "warning_s",
        "shoo_radius_m"
      ],
      "properties": {
        "steal_delay_s": {
          "type": "number"
        },
        "cooldown_s": {
          "type": "number"
        },
        "min_item_value": {
          "type": "number"
        },
        "warning_s": {
          "type": "number"
        },
        "shoo_radius_m": {
          "type": "number"
        }
      }
