{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cabay.local/schemas/spawn_tables.schema.json",
  "title": "Bảng xuất hiện",
  "description": "data/content/spawn_tables.json",
  "type": "object",
  "required": [
    "schema_version",
    "meta",
    "records"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "meta": {
      "$ref": "common.schema.json#/$defs/meta"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "entries",
          "fallback_creature_id"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/spawn_table_id"
          },
          "status": {
            "$ref": "common.schema.json#/$defs/status"
          },
          "entries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "creature_id",
                "weight",
                "bait_ids",
                "min_rod_tier"
              ],
              "properties": {
                "creature_id": {
                  "$ref": "common.schema.json#/$defs/creature_id"
                },
                "weight": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "bait_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/bait_id"
                  },
                  "description": "Rỗng = mọi mồi"
                },
                "min_rod_tier": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "fallback_creature_id": {
            "$ref": "common.schema.json#/$defs/creature_id"
          }
        }
      }
    }
  }
}
