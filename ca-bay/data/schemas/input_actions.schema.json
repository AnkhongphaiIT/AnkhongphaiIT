{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cabay.local/schemas/input_actions.schema.json",
  "title": "Hành động nhập liệu",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "actions"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "desktop",
          "touch",
          "desc",
          "status"
        ],
        "properties": {
          "action": {
            "type": "string",
            "pattern": "^[a-z_0-9]+$"
          },
          "desktop": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "touch": {
            "type": "string"
          },
          "gamepad": {
            "type": "string"
          },
          "desc": {
            "type": "string"
          },
          "status": {
            "$ref": "common.schema.json#/$defs/status"
          },
          "debug_only": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
