{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cabay.local/schemas/tools.schema.json",
  "title": "Công cụ",
  "description": "data/content/tools.json",
  "type": "object",
  "required": [
    "schema_version",
    "meta",
    "records"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "meta": {
      "$ref": "common.schema.json#/$defs/meta"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name_key",
          "status",
          "kind",
          "damage",
          "range_m",
          "cooldown_s",
          "knockback",
          "assets"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/tool_id"
          },
          "name_key": {
            "$ref": "common.schema.json#/$defs/loc_key"
          },
          "status": {
            "$ref": "common.schema.json#/$defs/status"
          },
          "kind": {
            "enum": [
              "melee",
              "throwable",
              "ranged",
              "explosive"
            ]
          },
          "damage": {
            "type": "integer",
            "minimum": 0
          },
          "range_m": {
            "type": "number",
            "minimum": 0
          },
          "arc_deg": {
            "type": "number",
            "minimum": 0,
            "maximum": 360
          },
          "cooldown_s": {
            "type": "number",
            "minimum": 0
          },
          "knockback": {
            "type": "number",
            "minimum": 0
          },
          "launch_up": {
            "type": "number",
            "minimum": 0,
            "description": "Lực hất lên (m/s) — dùng để tâng cá"
          },
          "throw_speed_mps": {
            "type": "number",
            "minimum": 0
          },
          "stun_s": {
            "type": "number",
            "minimum": 0
          },
          "radius_m": {
            "type": "number",
            "minimum": 0
          },
          "fuse_s": {
            "type": "number",
            "minimum": 0
          },
          "auto_return_s": {
            "type": "number",
            "minimum": 0,
            "description": "Vật ném không được nhặt/rơi xuống nước sâu sẽ tự về tay sau số giây này"
          },
          "ammo": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "max",
              "recover"
            ],
            "properties": {
              "max": {
                "type": "integer",
                "minimum": 0
              },
              "recover": {
                "enum": [
                  "pickup",
                  "infinite",
                  "buy"
                ]
              }
            }
          },
          "hit_text_key": {
            "$ref": "common.schema.json#/$defs/loc_key"
          },
          "assets": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "model",
              "icon"
            ],
            "properties": {
              "model": {
                "$ref": "common.schema.json#/$defs/asset_id"
              },
              "icon": {
                "$ref": "common.schema.json#/$defs/asset_id"
              }
            }
          }
        }
      }
    }
  }
}
