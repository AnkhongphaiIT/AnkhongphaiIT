; CÁ BAY — Godot 4.7.2 (xem toolchain.lock.json)

config_version=5

[application]

config/name="CÁ BAY"
config/description="Game câu cá co-op 1–4 người, web máy tính (tên tạm)."
config/version="0.1.0"
run/main_scene="res://client/scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/textures/icon.svg"
run/max_fps=0

[autoload]

ContentDB="*res://shared/content/content_db.gd"
Loc="*res://client/scripts/core/loc.gd"
Settings="*res://client/scripts/core/settings.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/default_font_multichannel_signed_distance_field=false

[internationalization]

locale/fallback="en"

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=9.8

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=false
lights_and_shadows/directional_shadow/size=2048
environment/defaults/default_clear_color=Color(0.53, 0.8, 0.95, 1)
anti_aliasing/quality/msaa_3d=0
